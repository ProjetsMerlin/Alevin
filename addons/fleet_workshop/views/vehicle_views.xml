<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_fleet_vehicle_tree" model="ir.ui.view">
    <field name="name">fleet.vehicle.tree</field>
    <field name="model">fleet.vehicle</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="brand"/>
        <field name="model"/>
        <field name="immatriculation"/>
        <field name="mileage"/>
        <field name="state"/>
      </list>
    </field>
  </record>

  <record id="action_fleet_vehicle" model="ir.actions.act_window">
    <field name="name">Vehicles</field>
    <field name="res_model">fleet.vehicle</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="context">
            {
                'group_by': 'state'
            }
    </field>
  </record>

  <record id="view_fleet_vehicle_form" model="ir.ui.view">
    <field name="name">fleet.vehicle.form</field>
    <field name="model">fleet.vehicle</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="image" widget="image"/>
          </group>
          <group>
            <field name="name"/>
            <field name="brand"/>
            <field name="model"/>
          </group>
          <group>
            <field name="immatriculation"/>
            <field name="purchase_date"/>
            <field name="mileage"/>
            <field name="state"/>
          </group>
          <notebook>
            <page string="Interventions">
              <field name="intervention_ids">
                <list editable="bottom">
                  <field name="date"/>
                  <field name="name"/>
                  <field name="cost"/>
                  <field name="customer_id"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_fleet_vehicle_kanban" model="ir.ui.view">
    <field name="name">fleet.vehicle.kanban</field>
    <field name="model">fleet.vehicle</field>
    <field name="arch" type="xml">
      <kanban default_group_by="state">
        <field name="image"/>
        <field name="name"/>
        <field name="brand"/>
        <field name="model"/>
        <field name="immatriculation"/>
        <field name="state"/>
        <field name="mileage"/>
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_global_click">
            <div>
              <img t-att-src="kanban_image('fleet.vehicle', 'image', record.id.value)" class="o_kanban_image w-100 mb-4" />
            </div>
              <div>
                <h3>
                  <field name="name"/>
                </h3>
              </div>
              <div>
                <h4><field name="brand"/>-<field name="model"/></h4>
              </div>
              <div style="color: red;">
                <field  name="immatriculation"/>
              </div>
              <div>
                <field name="mileage"/> km
              </div>

              <div>
                <field name="state"/>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <menuitem id="menu_fleet_root" name="Fleet Workshop" sequence="10"/>

  <menuitem id="menu_fleet_vehicle" name="Vehicles" parent="menu_fleet_root" action="action_fleet_vehicle"/>

</odoo>