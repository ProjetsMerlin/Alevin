<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_fleet_intervention_tree" model="ir.ui.view">
    <field name="name">fleet.intervention.tree</field>
    <field name="model">fleet.intervention</field>
    <field name="arch" type="xml">

      <list>
        <field name="date"/>
        <field name="vehicle_id"/>
        <field name="customer_id"/>
        <field name="mechanic_id"/>
        <field name="cost"/>
      </list>

    </field>
  </record>

  <record id="view_fleet_intervention_form" model="ir.ui.view">
    <field name="name">fleet.intervention.form</field>
    <field name="model">fleet.intervention</field>
    <field name="arch" type="xml">

      <form>
        <sheet>

          <group>
            <field name="name"/>
            <field name="date"/>
          </group>

          <group>
            <field name="vehicle_id"/>
            <field name="customer_id"/>
            <field name="mechanic_id"/>
          </group>

          <group>
            <field name="cost"/>
          </group>

          <group>
            <field name="notes"/>
          </group>

        </sheet>
      </form>

    </field>
  </record>

  <record id="action_fleet_intervention" model="ir.actions.act_window">
    <field name="name">Interventions</field>
    <field name="res_model">fleet.intervention</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_fleet_intervention" name="Interventions" parent="menu_fleet_root" action="action_fleet_intervention" sequence="20"/>

</odoo>